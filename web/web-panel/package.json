{
  "name": "xiaozhi-iot-panel",
  "version": "1.0.0",
  "private": true,
  "description": "银龄智享 IoT 控制面板 Monorepo",
  "scripts": {
    "dev": "concurrently \"npm run dev -w @xiaozhi/backend\" \"npm run dev -w @xiaozhi/frontend\"",
    "build": "npm run build -w @xiaozhi/shared && npm run build -w @xiaozhi/frontend",
    "start": "npm run start -w @xiaozhi/backend"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "typescript": "^5.4.0"
  },
  "workspaces": [
    "packages/*"
  ]
}
